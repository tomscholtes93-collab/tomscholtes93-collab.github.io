---
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/components.css';
import '../styles/pages.css';
import { ClientRouter } from 'astro:transitions';
import JsonLdPerson from '../components/JsonLdPerson.astro';
import {
  LOCALES,
  DEFAULT_LOCALE,
  getLocale,
  localizePath,
  delocalizePath,
  t as translate,
  type Locale,
} from '../i18n';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  jsonLd?: boolean;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  publishedTime?: string;
}

const {
  title,
  description,
  path = '/',
  jsonLd = false,
  noindex = false,
  ogType = 'website',
  publishedTime,
} = Astro.props;

const locale = (Astro.currentLocale ?? getLocale(Astro.url)) as Locale;
const t = (k: string, vars?: Record<string, string | number>) => translate(k, locale, vars);

const resolvedTitle = title ?? t('meta.home.title');
const resolvedDesc = description ?? t('meta.home.description');

const SITE = Astro.site ?? new URL('https://tomscholtes.com');
// path is the unlocalized logical path; delocalize defensively so a
// pre-localized prop can never yield /de/de/... URLs again.
const logicalPath = delocalizePath(path);
const canonical = new URL(localizePath(logicalPath, locale), SITE).toString();
const ogImage = 'https://tomscholtes.com/og/default.png';
const ogImageAlt = 'Tom Scholtes. Six years, quietly automated.';
const OG_LOCALE: Record<Locale, string> = {
  en: 'en_GB',
  de: 'de_DE',
  fr: 'fr_FR',
  ru: 'ru_RU',
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{resolvedTitle}</title>
    <meta name="description" content={resolvedDesc} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex &&
      LOCALES.map((l) => (
        <link
          rel="alternate"
          hreflang={l}
          href={new URL(localizePath(logicalPath, l), SITE).toString()}
        />
      ))}
    {!noindex && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={new URL(localizePath(logicalPath, DEFAULT_LOCALE), SITE).toString()}
      />
    )}
    {/* The feed, discoverable. Added 2026-08-01 with /rss.xml: an aggregator
        finds a feed by this link element, so shipping the endpoint without it
        would mean a feed only a reader who guessed the URL could subscribe to.
        Per-locale, so a German reader's reader gets the German feed. Emitted
        even on a noindex page: "do not index this" and "here is the site's
        feed" are unrelated statements. */}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={t('meta.notes.index.title')}
      href={new URL(localizePath('/rss.xml', locale), SITE).toString()}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content={ogType} />
    {ogType === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime} />
    )}
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={resolvedDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content="Tom Scholtes" />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {LOCALES.filter((l) => l !== locale).map((l) => (
      <meta property="og:locale:alternate" content={OG_LOCALE[l]} />
    ))}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={resolvedDesc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link
      rel="preload"
      href="/fonts/instrument-serif-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-500.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>
      (function () {
        // This existing subsystem owns restoration and all control writes.
        let current;
        function defaults() {
          return {
            theme: matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light',
            accent: 'terracotta',
            density: 'default',
          };
        }
        function normalize(value) {
          const fallback = defaults();
          const prefs = value && typeof value === 'object' && !Array.isArray(value) ? value : {};
          return {
            theme: ['light', 'dark', 'ink'].includes(prefs.theme) ? prefs.theme : fallback.theme,
            accent: ['terracotta', 'ink', 'forest', 'amber', 'violet'].includes(prefs.accent)
              ? prefs.accent
              : fallback.accent,
            density: ['compact', 'default', 'airy'].includes(prefs.density)
              ? prefs.density
              : fallback.density,
          };
        }
        function storageFailure(error) {
          if (
            error instanceof SyntaxError ||
            (error instanceof DOMException &&
              ['SecurityError', 'QuotaExceededError'].includes(error.name))
          ) {
            console.warn(
              'Display preferences unavailable; using readable defaults or current settings.',
            );
            return;
          }
          throw error;
        }
        function read() {
          try {
            const saved = JSON.parse(localStorage.getItem('ts-display-prefs') || '{}');
            if (saved && typeof saved === 'object' && !Array.isArray(saved) && !saved.density)
              saved.density = localStorage.getItem('density');
            return normalize(saved);
          } catch (error) {
            storageFailure(error);
            return current || defaults();
          }
        }
        function apply(prefs) {
          current = normalize(prefs);
          const root = document.documentElement;
          root.setAttribute('data-theme', current.theme);
          root.setAttribute('data-accent', current.accent);
          if (current.density === 'default') root.removeAttribute('data-density');
          else root.setAttribute('data-density', current.density);
          window.dispatchEvent(new CustomEvent('ts-display-prefs', { detail: current }));
        }
        function save(prefs) {
          apply(prefs);
          try {
            localStorage.setItem('ts-display-prefs', JSON.stringify(current));
          } catch (error) {
            storageFailure(error);
          }
          return current;
        }
        window.tsDisplayPrefs = { read: read, save: save };
        apply(read());
        document.addEventListener('astro:after-swap', function () {
          apply(read());
        });
      })();
    </script>

    {jsonLd && <JsonLdPerson />}
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      {t('nav.skip')}
    </a>
    <slot />
    {/* Text justification retired 2026-06-23: prose is ragged-right (left-aligned). */}
  </body>
</html>
