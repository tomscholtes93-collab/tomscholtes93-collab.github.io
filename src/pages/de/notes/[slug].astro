---
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import RevealObserver from '../../../components/RevealObserver.astro';
import PageVideo from '../../../components/PageVideo.astro';
import JsonLdArticle from '../../../components/JsonLdArticle.astro';
import ReplySurface from '../../../components/ReplySurface.astro';
import GiscusThread from '../../../components/GiscusThread.astro';
import { publishedNotes, noteSlug } from '../../../lib/notes';
import { getCollection, type CollectionEntry } from 'astro:content';
import { t as translate, getLocale, localizePath, localeDateFmt, type Locale } from '../../../i18n';

export async function getStaticPaths() {
  const entries = await getCollection('notes', ({ data, slug }) =>
    data.status === 'published' && slug.startsWith('de/'));
  return entries.map((entry) => ({
    params: { slug: entry.slug.replace(/^de\//, '') },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'notes'>;
}
const { entry } = Astro.props;
const { Content } = await entry.render();

const locale = (Astro.currentLocale ?? getLocale(Astro.url)) as Locale;
const t = (k: string) => translate(k, locale);
const fmt = localeDateFmt(locale);
const displaySlug = entry.slug.replace(/^de\//, '');
/* The eyebrow used to be one joined string, which is why the tags in it were
   unclickable: a reader finished an essay, saw its three subjects, and had
   nowhere to go. It is structured now so each tag is a link.

   Hrefs are keyed by the ENGLISH tag at the same array index, because tags here
   are translated per locale and the tag routes are keyed on the English one to
   keep URL segments ASCII. The visible text stays the local label. See
   src/lib/notes.ts. */
const eyebrowPrefix = `${t('notes.detail.eyebrow.prefix')} · ${fmt.format(entry.data.publishDate)}`;
const enTags = (await publishedNotes('en')).find((e) => noteSlug(e) === displaySlug)?.data.tags
  ?? entry.data.tags;
const tagLinks = entry.data.tags.map((label, i) => ({
  label,
  href: localizePath(`/tags/${enTags[i] ?? label}/`, locale),
}));

const relatedEntries = entry.data.related.length
  ? (await getCollection('notes', ({ data, slug }) =>
      data.status === 'published' && entry.data.related.map((r) => `de/${r}`).includes(slug)))
  : [];
const notesHref = localizePath('/notes/', locale);
/* Absolute canonical URL of this locale's copy of the essay, built through the
   same localizePath + Astro.site pair Base.astro uses for <link rel=canonical>,
   so the address a reader is told to cite is byte-identical to the one search
   engines are told is canonical. Falls back to the production origin when
   Astro.site is unset, which it never is here (astro.config.mjs sets it). */
const essayUrl = new URL(
  localizePath(`/notes/${displaySlug}/`, locale),
  Astro.site ?? 'https://tomscholtes.com',
).toString();
---
<Base
  title={`${entry.data.title} · Tom Scholtes`}
  description={entry.data.summary}
  path={`/notes/${displaySlug}/`}
  ogType="article"
  publishedTime={entry.data.publishDate.toISOString().slice(0, 10)}
>
  <JsonLdArticle
    title={entry.data.title}
    description={entry.data.summary}
    datePublished={entry.data.publishDate}
    tags={entry.data.tags}
    path={`/notes/${displaySlug}/`}
  />
  <Nav active="notes" />
  <main>
    <section>
      <div class="container">
        <article class="note-article">
          <header class="note-header">
            <p class="eyebrow mono">
              {eyebrowPrefix}
              {tagLinks.map((tg) => (
                <>{' · '}<a href={tg.href} class="tag-link">{tg.label}</a></>
              ))}
            </p>
            <h1 class="serif note-title" transition:name={`note-title-${displaySlug}`}>{entry.data.title}</h1>
            <p class="lead note-summary" transition:name={`note-summary-${displaySlug}`}>{entry.data.summary}</p>
          </header>
          <PageVideo slug={displaySlug} />
          <Content />

          <footer class="note-footer">
            {entry.data.sources.length > 0 && (
              <section class="note-sources">
                <h2 class="eyebrow">{t('notes.detail.sources.heading')}</h2>
                <ul>
                  {entry.data.sources.map((s) => (
                    <li>
                      {s.href ? <a href={s.href}>{s.label}</a> : s.label}
                      <span class="mono">· {s.kind}</span>
                    </li>
                  ))}
                </ul>
              </section>
            )}

            {relatedEntries.length > 0 && (
              <section class="note-related">
                <h2 class="eyebrow">{t('notes.detail.related.heading')}</h2>
                <ul>
                  {relatedEntries.map((r) => (
                    <li><a href={localizePath(`/notes/${r.slug.replace(/^de\//, '')}/`, locale)} data-astro-prefetch>{r.data.title}</a></li>
                  ))}
                </ul>
              </section>
            )}

            <p class="back mono"><a href={notesHref}>{t('notes.detail.back')}</a></p>

            {/* LAYER 1, always rendered. LAYER 2 mounts below it and only when
                src/config/comments.ts is switched on; while it is off,
                GiscusThread renders literally nothing, not even its host div.
                Thread identity is the SLUG, so one essay hosts one
                conversation across all four locales. */}
            <ReplySurface title={entry.data.title} url={essayUrl} locale={locale} />
            <GiscusThread slug={displaySlug} locale={locale} />
          </footer>
        </article>
      </div>
    </section>
  </main>
  <Footer />
  <RevealObserver />
</Base>
