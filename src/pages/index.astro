---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import NoteCard from '../components/NoteCard.astro';
import RevealObserver from '../components/RevealObserver.astro';
import DisplayPanel from '../components/islands/DisplayPanel.jsx';
import TweaksPanel from '../components/islands/TweaksPanel.jsx';
import { publishedNotes, tagGroups, noteSlug } from '../lib/notes';
import { t as translate, getLocale, localizePath, type Locale } from '../i18n';

const locale = (Astro.currentLocale ?? getLocale(Astro.url)) as Locale;
const t = (k: string) => translate(k, locale);

const entries = await publishedNotes(locale);
const topics = (await tagGroups(locale)).slice(0, 6);
const latest = entries[0];
const link = (path: string) => localizePath(path, locale);
---

<Base jsonLd={true}>
  <Nav active="home" />
  <main id="main-content" tabindex="-1">
    <header class="paper notes-index-header editorial-masthead">
      <div class="container masthead-grid">
        <div>
          <span class="eyebrow">{t('home.masthead.eyebrow')}</span>
          <h1 class="title">
            {t('home.masthead.heading.pre')} <em>{t('home.masthead.heading.em')}</em>
            {t('home.masthead.heading.post')}
          </h1>
          <p class="sub">{t('home.masthead.sub')}</p>
          <div class="reading-actions">
            <a class="btn btn-primary" href="#essays">
              {t('editorial.browse')}
            </a>
            <a class="reading-link" href={link('/notes/archive/')}>
              {t('nav.archive')} <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        {latest && (
          <aside class="latest-reading" aria-labelledby="latest-label">
            <span class="eyebrow" id="latest-label">
              {t('editorial.latest')}
            </span>
            <h2>
              <a href={link(`/notes/${noteSlug(latest)}/`)}>{latest.data.title}</a>
            </h2>
            <p>{latest.data.summary}</p>
            <a class="reading-link" href={link(`/notes/${noteSlug(latest)}/`)}>
              {t('editorial.read')} <span aria-hidden="true">→</span>
            </a>
          </aside>
        )}
      </div>
    </header>

    <section class="notes-index" id="essays" aria-labelledby="essays-heading">
      <div class="container">
        <div class="reading-section-head">
          <h2 class="eyebrow" id="essays-heading">
            {t('editorial.essays')}
          </h2>
          <a class="reading-link" href={link('/rss.xml')}>
            {t('nav.rss')}
          </a>
        </div>
        <ol class="notes-list">
          {entries.map((entry, i) => (
            <li class="reveal" style={`--reveal-delay: ${Math.min(i, 6) * 45}ms`}>
              <NoteCard entry={entry} />
            </li>
          ))}
        </ol>
      </div>
    </section>
    <section class="reading-pathways" aria-labelledby="pathways-heading">
      <div class="container pathways-grid">
        <div>
          <h2 id="pathways-heading">{t('editorial.explore')}</h2>
          <p>{t('editorial.explore.sub')}</p>
          <div class="topic-links">
            {topics.map((topic) => (
              <a href={link(`/tags/${topic.key}/`)}>{topic.label}</a>
            ))}
          </div>
          <a class="reading-link" href={link('/tags/')}>
            {t('nav.tags')} <span aria-hidden="true">→</span>
          </a>
        </div>
        <nav class="context-links" aria-label={t('editorial.context')}>
          <span class="eyebrow">{t('editorial.context')}</span>
          <a href={link('/projects/')}>
            {t('nav.projects')} <span aria-hidden="true">↗</span>
          </a>
          <a href={link('/thesis/')}>
            {t('footer.thesis')} <span aria-hidden="true">↗</span>
          </a>
          <a href={link('/about/')}>
            {t('nav.about')} <span aria-hidden="true">↗</span>
          </a>
          <a href={link('/cv/')}>
            {t('nav.cv')} <span aria-hidden="true">↗</span>
          </a>
          <a href={`${link('/about/')}#contact`}>
            {t('nav.contact')} <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>
    </section>
  </main>
  <Footer />

  <DisplayPanel client:idle />
  <TweaksPanel client:idle />
  <RevealObserver />
</Base>
