---
import { t as translate, getLocale, localizePath, type Locale } from '../i18n';

const locale = (Astro.currentLocale ?? getLocale(Astro.url)) as Locale;
const t = (k: string, vars?: Record<string, string | number>) => translate(k, locale, vars);
const projects = localizePath('/projects', locale);
const notes = localizePath('/notes/', locale);
const thesis = localizePath('/thesis', locale);
const about = localizePath('/about/', locale);
const cv = localizePath('/cv/', locale);
const tags = localizePath('/tags/', locale);
const year = new Date().getFullYear();
---
<footer>
  <div class="container">
    <div class="foot-grid">
      <div>
        <div class="brand" style="margin-bottom:14px">
          <span class="brand-mark">T</span>
          <span style="color:var(--ink); font-weight:600">{t('nav.brand')}</span>
        </div>
        <p style="margin:0; max-width:38ch; font-size:14px">
          {t('footer.tagline')}
        </p>
      </div>
      <div>
        <h2>{t('footer.col.site')}</h2>
        {/* Every href here resolves. #now and #reading used to hang off `/`;
            those two sections render at /about/ as of 2026-08-01, so the
            fragments follow them. #work and #cv were removed earlier the same
            day for the opposite reason: they pointed at sections that had left
            the homepage without a fragment to land on, and an anchor with no
            target silently drops the reader at the top of the page. /cv/ has a
            real address and is linked as one. */}
        <a href={notes}>{t('nav.notes')}</a>
        <a href={tags}>{t('nav.tags')}</a>
        <a href={about}>{t('nav.about')}</a>
        <a href={cv}>{t('nav.cv')}</a>
        <a href={projects}>{t('nav.projects')}</a>
        <a href={`${about}#now`}>{t('nav.now')}</a>
        <a href={`${about}#reading`}>{t('nav.reading')}</a>
      </div>
      <div>
        <h2>{t('footer.col.elsewhere')}</h2>
        <a href="https://www.linkedin.com/in/tomscholtes93/" target="_blank" rel="noopener">{t('footer.linkedin')}</a>
        <a href={thesis}>{t('footer.thesis')}</a>
      </div>
      <div>
        <h2>{t('footer.col.contact')}</h2>
        <a href="mailto:tom@tomscholtes.com">tom@tomscholtes.com</a>
        <a href={`${about}#contact`}>{t('footer.email.cta')}</a>
      </div>
    </div>
    <div class="foot-bottom">
      <span>{t('footer.copyright', { year })}</span>
      <span>{t('footer.opinions')}</span>
    </div>
  </div>
</footer>
