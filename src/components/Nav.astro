---
import Arr from './Arr.astro';
import LangSwitcher from './LangSwitcher.astro';
import { t as translate, getLocale, localizePath, type Locale } from '../i18n';

interface Props {
  active?: string;
}
const { active = '' } = Astro.props;
const current = (name: string, href: string) =>
  Astro.url.pathname === href ? 'page' : active === name ? 'location' : undefined;

const locale = (Astro.currentLocale ?? getLocale(Astro.url)) as Locale;
const t = (k: string) => translate(k, locale);
const home = localizePath('/', locale);
const projects = localizePath('/projects/', locale);
const notes = localizePath('/notes/', locale);
const about = localizePath('/about/', locale);
const cv = localizePath('/cv/', locale);
---

<header class="nav" id="site-nav" data-open="false">
  <div class="container nav-inner">
    <a href={home} class="brand" aria-current={current('home', home)}>
      <span class="brand-mark">T</span>
      <span>{t('nav.brand')}</span>
    </a>
    <nav class="nav-links" id="primary-navigation" aria-label={t('footer.col.site')}>
      <a href={notes} aria-current={current('notes', notes)}>
        {t('nav.notes')}
      </a>
      <a href={about} aria-current={current('about', about)}>
        {t('nav.about')}
      </a>
      <a href={cv} aria-current={current('cv', cv)}>
        {t('nav.cv')}
      </a>
      <a href={projects} aria-current={current('projects', projects)}>
        {t('nav.projects')}
      </a>
      <a href={`${about}#contact`} class="nav-link-menu-only">
        {t('nav.contact')}
      </a>
    </nav>
    <LangSwitcher />
    <a href={`${about}#contact`} class="nav-cta">
      {t('nav.cta')} <Arr />
    </a>
    <button
      type="button"
      class="nav-toggle"
      aria-controls="primary-navigation"
      aria-label={t('nav.menu.open')}
      aria-expanded="false"
      data-label-open={t('nav.menu.open')}
      data-label-close={t('nav.menu.close')}
    >
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>
  </div>
</header>

<script>
  let disposeMenu: (() => void) | undefined;
  function initMenu() {
    disposeMenu?.();
    const nav = document.getElementById('site-nav');
    const button = nav?.querySelector<HTMLButtonElement>('.nav-toggle');
    if (!nav || !button) return;
    const controller = new AbortController();
    const options = { signal: controller.signal };
    function setOpen(open: boolean) {
      if (!nav || !button) return;
      nav.dataset.open = String(open);
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute(
        'aria-label',
        (open ? button.dataset.labelClose : button.dataset.labelOpen) || '',
      );
    }
    setOpen(false);
    nav.dataset.enhanced = 'true';
    button.addEventListener('click', () => setOpen(nav.dataset.open !== 'true'), options);
    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Escape' && nav.dataset.open === 'true') {
          setOpen(false);
          button.focus();
        }
      },
      options,
    );
    nav.addEventListener(
      'click',
      (event) => {
        if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
      },
      options,
    );
    // Close after activation. Closing on blur moves a link under the pointer
    // between pointerdown and click, which can discard the reader's first click.
    document.addEventListener(
      'click',
      (event) => {
        if (event.target instanceof Node && !nav.contains(event.target)) setOpen(false);
      },
      options,
    );
    const desktop = matchMedia('(min-width: 981px)');
    desktop.addEventListener('change', () => setOpen(false), options);
    disposeMenu = () => {
      setOpen(false);
      controller.abort();
    };
  }
  initMenu();
  document.addEventListener('astro:page-load', initMenu);
  document.addEventListener('astro:before-swap', () => disposeMenu?.());
  window.addEventListener('pageshow', initMenu);
</script>
