---
// Person + WebSite entity graph, rendered on the four home pages and the four
// /about/ pages.
// Every claim here must already be published on the site (no-fabrication gate):
// jobTitle and languages appear on /about/ (they were on the homepage until
// 2026-08-01, when the Hero and Languages sections moved there and `/` became
// the essay feed), Erasmus University Rotterdam on the thesis page, the
// knowsAbout topics in the case studies and notes.
const SITE = 'https://tomscholtes.com';
const data = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${SITE}/#person`,
      name: 'Tom Scholtes',
      jobTitle: 'Finance ops engineer',
      nationality: { '@type': 'Country', name: 'Luxembourg' },
      knowsLanguage: ['en', 'de', 'fr', 'ru', 'lb', 'uz'],
      alumniOf: {
        '@type': 'EducationalOrganization',
        name: 'Erasmus University Rotterdam',
      },
      knowsAbout: [
        'workflow automation',
        'fund services operations',
        'AI agents',
        'Model Context Protocol (MCP)',
        'retrieval-augmented generation',
      ],
      url: SITE,
      image: `${SITE}/og/default.png`,
      sameAs: [
        'https://www.linkedin.com/in/tomscholtes93/',
        'https://github.com/tomscholtes93-collab',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      name: 'Tom Scholtes',
      url: SITE,
      inLanguage: ['en', 'de', 'fr', 'ru'],
      publisher: { '@id': `${SITE}/#person` },
    },
    // Added 2026-08-01 with the subtraction. The entity graph described a
    // person and a website and said nothing about the thing the site is now
    // organised around, so a crawler had no way to read /notes/ as a
    // publication. Every claim below is already published: the essays exist
    // at /notes/<slug>/ in four locales.
    // The @id and url stay at /notes/ now that `/` carries the same feed. That
    // is the address the publication was first published at, an @id is meant to
    // be stable, and re-pointing it would churn the node for no gain. The
    // duplication of the list across two URLs is recorded in docs/DECISIONS.md.
    {
      '@type': 'Blog',
      '@id': `${SITE}/notes/#blog`,
      name: 'Notes',
      url: `${SITE}/notes/`,
      inLanguage: ['en', 'de', 'fr', 'ru'],
      isPartOf: { '@id': `${SITE}/#website` },
      author: { '@id': `${SITE}/#person` },
      publisher: { '@id': `${SITE}/#person` },
    },
  ],
};
const json = JSON.stringify(data).replace(/</g, '\\u003c');
---
<script type="application/ld+json" set:html={json} />
